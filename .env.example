# Copy this file to .env and fill in the values relevant to your setup.
# .env is loaded automatically by scripts/run_graph.py and
# scripts/run_eval.py via python-dotenv. Never commit your real .env file.

# ---------------------------------------------------------------------------
# Model selection
# ---------------------------------------------------------------------------

# LangChain provider-prefixed model identifier used by every agent role
# unless overridden in src/cando/config.py's ModelsConfig (e.g.
# "azure_openai:gpt-5.2", "openai:some-model", "google_genai:gemini-...").
# Defaults to "azure_openai:gpt-5.2" (the model used for the paper's
# reported results) when unset.
CANDO_MODEL_ID=azure_openai:gpt-5.2

# Inference profile applied to every role's token/thinking budget: one of
# "no_thinking", "fast", "max". Defaults to "max" (uncapped, historical
# default behavior) when unset.
CANDO_INFERENCE_PROFILE=max

# ---------------------------------------------------------------------------
# Model provider credentials (set the block matching your CANDO_MODEL_ID
# provider prefix)
# ---------------------------------------------------------------------------

# azure_openai: (default provider)
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# OPENAI_API_VERSION=

# openai: (also used to point at a self-hosted OpenAI-compatible server,
# e.g. vLLM -- see slurm/run_ablation.slurm)
# OPENAI_API_KEY=
# OPENAI_API_BASE=

# ---------------------------------------------------------------------------
# GeneratorZero exemplar retrieval (required to run the full graph;
# all three must be set, or GeneratorZero() raises ValueError)
# ---------------------------------------------------------------------------

# Path to the training layouts .jsonl file (train.jsonl, with full
# polygons for every element); supplies the exemplar outputs.
DATASET_JSONL_PATH=

# Path to a parquet file of precomputed per-layout feature vectors,
# keyed by layout id to DATASET_JSONL_PATH, used for nearest-neighbour
# exemplar retrieval.
FEATURE_VECTORS_PARQUET_PATH=

# Path to the feature-scaler config JSON matching the feature vectors
# above (produced by scripts/extract_exemplar_features.py).
SCALER_CONFIG_PATH=
